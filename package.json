{
  "name": "ghcp-prompt-migration-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical Azure migration skills and agents, distributed through the VS Code extension and a native Copilot agent plugin.",
  "type": "module",
  "workspaces": [
    "packages/azure-migration-squad-vscode"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "sync": "npm run sync --workspaces --if-present",
    "validate:descriptions": "node scripts/validate-description-lengths.mjs",
    "validate:decision-coverage": "node scripts/validate-decision-coverage.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "test:release": "node --test scripts/local-release.test.mjs",
    "test:reporting": "python -B scripts/test-strategy-report.py",
    "inject:decision-gates": "node scripts/inject-decision-gates.mjs",
    "inject:capability-gates": "node scripts/inject-capability-matrix-gates.mjs",
    "validate:all": "npm run validate:descriptions && npm run validate:decision-coverage && npm run validate:plugin"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertoBorges/GHCP-PromptMigration.git"
  },
  "author": "Roberto Borges",
  "keywords": [
    "azure",
    "migration",
    "copilot",
    "modernization"
  ]
}
